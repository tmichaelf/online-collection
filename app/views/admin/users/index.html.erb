<% content_for :title, "Users" %>

<h1>Users</h1>

<table class="admin-table">
  <thead>
    <tr>
      <th scope="col">Username</th>
      <th scope="col">Email address</th>
      <th scope="col">Titles</th>
      <th scope="col">Role</th>
      <th scope="col"><span class="visually-hidden">Actions</span></th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= link_to user.username, collector_path(user) %></td>
        <td><%= user.email_address %></td>
        <td><%= user.collection_items.size %></td>
        <td><%= user.admin? ? "Admin" : "Collector" %></td>
        <td class="admin-table__actions"><%= link_to "Edit", edit_admin_user_path(user) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
