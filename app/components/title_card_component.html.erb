<article class="title-card">
  <%= link_to title, class: "title-card__link" do %>
    <span class="title-card__cover"><%= render BoxCoverComponent.new(title: title) %></span>
    <p class="title-card__record">No. <%= record_number %></p>
    <h3 class="title-card__name"><%= title.name %></h3>
  <% end %>
  <% if byline.present? %>
    <p class="title-card__byline"><%= byline %></p>
  <% end %>
  <% if condition %>
    <%= render ConditionBadgeComponent.new(condition: condition) %>
  <% end %>
</article>
